<script>
/* ==========================================================
   1. CUSTOM CURSOR — dot + lagging ring + hover state
   ========================================================== */
const dot = document.getElementById('cursorDot');
const ring = document.getElementById('cursorRing');
const isTouch = matchMedia('(hover: none)').matches;

if (!isTouch) {
  let mx = 0, my = 0, rx = 0, ry = 0;

  document.addEventListener('mousemove', (e) => {
    mx = e.clientX; my = e.clientY;
    dot.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;
  });

  (function tick() {
    rx += (mx - rx) * 0.18;
    ry += (my - ry) * 0.18;
    ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;
    requestAnimationFrame(tick);
  })();

  document.querySelectorAll('a, button, [data-magnetic], .outline').forEach(el => {
    el.addEventListener('mouseenter', () => ring.classList.add('hover'));
    el.addEventListener('mouseleave', () => ring.classList.remove('hover'));
  });
}

/* ==========================================================
   2. CLICK RIPPLE — red circle explodes on click
   ========================================================== */
if (!isTouch) {
  document.addEventListener('mousedown', (e) => {
    const r = document.createElement('div');
    r.style.cssText = `
      position: fixed;
      left: ${e.clientX}px; top: ${e.clientY}px;
      width: 12px; height: 12px;
      background: var(--red);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      pointer-events: none; z-index: 9999;
      box-shadow: 0 0 40px var(--red-glow);
    `;
    document.body.appendChild(r);
    r.animate(
      [
        { transform: 'translate(-50%, -50%) scale(0)', opacity: 1 },
        { transform: 'translate(-50%, -50%) scale(16)', opacity: 0 }
      ],
      { duration: 700, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
    ).onfinish = () => r.remove();
  });
}

/* ==========================================================
   3. MAGNETIC ELEMENTS
   ========================================================== */
document.querySelectorAll('[data-magnetic]').forEach(el => {
  el.addEventListener('mousemove', (e) => {
    const r = el.getBoundingClientRect();
    const x = e.clientX - r.left - r.width / 2;
    const y = e.clientY - r.top - r.height / 2;
    el.style.transform = `translate(${x * 0.25}px, ${y * 0.3}px)`;
  });
  el.addEventListener('mouseleave', () => {
    el.style.transform = 'translate(0, 0)';
  });
});

/* ==========================================================
   4. PARTICLE NETWORK CANVAS
      Nodes float, connect with red lines when near.
      Nodes also repel from the cursor.
   ========================================================== */
(function particleNetwork() {
  const canvas = document.getElementById('canvas');
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  let nodes = [];
  const NODE_COUNT = 70;
  const MAX_DIST = 160;
  const CURSOR_RADIUS = 130;

  let mouseX = -9999, mouseY = -9999;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.width  = innerWidth  * DPR;
    H = canvas.height = innerHeight * DPR;
    canvas.style.width  = innerWidth + 'px';
    canvas.style.height = innerHeight + 'px';
    ctx.scale(1, 1);
  }

  function seed() {
    nodes = [];
    for (let i = 0; i < NODE_COUNT; i++) {
      nodes.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.35 * DPR,
        vy: (Math.random() - 0.5) * 0.35 * DPR,
        r: (1 + Math.random() * 1.6) * DPR
      });
    }
  }

  addEventListener('resize', () => { resize(); seed(); });
  addEventListener('mousemove', (e) => {
    mouseX = e.clientX * DPR;
    mouseY = e.clientY * DPR;
  });
  addEventListener('mouseleave', () => { mouseX = -9999; mouseY = -9999; });

  function frame() {
    ctx.clearRect(0, 0, W, H);

    // Update
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;

      // Bounce
      if (n.x < 0 || n.x > W) n.vx *= -1;
      if (n.y < 0 || n.y > H) n.vy *= -1;

      // Cursor repulsion
      const dx = n.x - mouseX;
      const dy = n.y - mouseY;
      const d2 = dx * dx + dy * dy;
      const R = CURSOR_RADIUS * DPR;
      if (d2 < R * R) {
        const d = Math.sqrt(d2) || 1;
        const force = (R - d) / R;
        n.x += (dx / d) * force * 3 * DPR;
        n.y += (dy / d) * force * 3 * DPR;
      }
    }

    // Connections
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d = Math.hypot(dx, dy);
        const lim = MAX_DIST * DPR;
        if (d < lim) {
          const alpha = (1 - d / lim) * 0.45;
          ctx.strokeStyle = `rgba(230, 43, 30, ${alpha})`;
          ctx.lineWidth = 0.6 * DPR;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    // Nodes
    for (const n of nodes) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(230, 43, 30, 0.9)';
      ctx.shadowColor = 'rgba(230, 43, 30, 0.9)';
      ctx.shadowBlur = 8 * DPR;
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    requestAnimationFrame(frame);
  }

  resize(); seed(); frame();
})();

/* ==========================================================
   5. SMOOTH SCROLL FOR ANCHORS
   ========================================================== */
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', (e) => {
    const t = document.querySelector(a.getAttribute('href'));
    if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
  });
});
</script>

