<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TEDxVIT Pune 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:ital,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --red: #e62b1e;
    --red-deep: #b91c14;
    --red-glow: rgba(230, 43, 30, 0.6);
    --black: #000000;
    --white: #ffffff;
    --grey: #888888;
    --line: rgba(255,255,255,0.10);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --expo: cubic-bezier(0.16, 1, 0.3, 1);
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  html, body { height: 100%; overflow: hidden; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    cursor: none;
  }

  /* ============================================
     CURSOR — dot + lagging ring
     ============================================ */
  .cursor-dot {
    position: fixed; top: 0; left: 0;
    width: 6px; height: 6px;
    background: var(--red);
    border-radius: 50%;
    pointer-events: none;
    z-index: 10001;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 14px var(--red-glow);
    will-change: transform;
  }
  .cursor-ring {
    position: fixed; top: 0; left: 0;
    width: 40px; height: 40px;
    border: 1.5px solid var(--red);
    border-radius: 50%;
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    opacity: 0.5;
    transition: width 0.3s var(--ease), height 0.3s var(--ease), border-color 0.3s var(--ease), opacity 0.3s var(--ease);
    will-change: transform;
  }
  .cursor-ring.hover { width: 76px; height: 76px; border-color: var(--white); opacity: 1; }

  /* ============================================
     HERO
     ============================================ */
  .hero {
    position: relative;
    width: 100%; height: 100vh;
    background: var(--black);
    overflow: hidden;
  }

  /* Animated grid backdrop */
  .grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 90px 90px;
    mask-image: radial-gradient(ellipse at 40% 50%, black 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 40% 50%, black 10%, transparent 75%);
    animation: gridPan 40s linear infinite;
    z-index: 1;
  }
  @keyframes gridPan {
    0%   { background-position: 0 0; }
    100% { background-position: 90px 90px; }
  }

  /* Big rotating red ring behind text */
  .orbit-ring {
    position: absolute;
    top: 50%; left: 50%;
    width: 900px; height: 900px;
    margin-top: -450px; margin-left: -450px;
    border: 1px dashed rgba(230, 43, 30, 0.18);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
    animation: spin 90s linear infinite;
  }
  .orbit-ring:nth-child(2) {
    width: 620px; height: 620px;
    margin-top: -310px; margin-left: -310px;
    border-color: rgba(230, 43, 30, 0.28);
    border-style: solid;
    animation-direction: reverse;
    animation-duration: 60s;
  }
  .orbit-ring:nth-child(3) {
    width: 380px; height: 380px;
    margin-top: -190px; margin-left: -190px;
    border-color: rgba(230, 43, 30, 0.45);
    animation-duration: 40s;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Canvas for particle network */
  #canvas {
    position: absolute; inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* ============================================
     CONTENT
     ============================================ */
  .content {
    position: relative;
    z-index: 10;
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(24px, 3vw, 48px) clamp(24px, 5vw, 72px);
    display: flex;
    flex-direction: column;
  }

  /* TOP BAR */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    animation: fadeIn 0.9s var(--ease) 0.2s forwards;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-size: 1rem; font-weight: 700; letter-spacing: -0.02em;
  }
  .brand .ted { color: var(--red); }
  .brand .vit { color: var(--white); }
  .brand .dot { color: var(--grey); font-weight: 400; margin: 0 4px; }
  .brand .year { color: var(--grey); font-weight: 400; font-size: 0.85rem; letter-spacing: 0.15em; }

  .nav-links {
    display: none; gap: 36px; list-style: none;
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
  }
  .nav-links a {
    color: var(--grey); text-decoration: none;
    position: relative; padding: 6px 0;
    transition: color 0.3s var(--ease);
  }
  .nav-links a::after {
    content: '';
    position: absolute; left: 0; bottom: 0;
    width: 100%; height: 2px;
    background: var(--red);
    transform: scaleX(0); transform-origin: right;
    transition: transform 0.4s var(--ease);
  }
  .nav-links a:hover { color: var(--white); }
  .nav-links a:hover::after { transform: scaleX(1); transform-origin: left; }
  @media (min-width: 900px) { .nav-links { display: flex; } }

  /* ============ STAGE ============ */
  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 0;
    max-width: 900px;
  }

  /* Kicker */
  .kicker {
    display: inline-flex; align-items: center; gap: 14px;
    font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.42em; text-transform: uppercase;
    color: var(--red);
    margin-bottom: 36px;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.4s forwards;
  }
  .kicker::before {
    content: '';
    width: 0; height: 1px;
    background: var(--red);
    animation: lineGrow 0.9s var(--ease) 0.5s forwards;
  }
  @keyframes lineGrow {
    to { width: 40px; }
  }
  .kicker .blink {
    display: inline-block;
    width: 6px; height: 6px;
    background: var(--red);
    border-radius: 50%;
    animation: blink 1.6s ease-in-out infinite;
    box-shadow: 0 0 12px var(--red-glow);
  }
  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.2; transform: scale(0.6); }
  }

  /* ============ HEADLINE ============ */
  .headline {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(2.8rem, 7.5vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 36px;
  }

  .headline .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .headline .line > span {
    display: inline-block;
    transform: translateY(105%);
    animation: lineRise 1.2s var(--expo) forwards;
    will-change: transform;
  }
  .headline .line:nth-child(1) > span { animation-delay: 0.6s; }
  .headline .line:nth-child(2) > span { animation-delay: 0.75s; }
  .headline .line:nth-child(3) > span { animation-delay: 0.9s; }

  @keyframes lineRise {
    to { transform: translateY(0); }
  }

  /* Outline word with glitch on hover */
  .headline .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--red);
    text-stroke: 2px var(--red);
    position: relative;
    cursor: none;
    transition: color 0.35s var(--ease);
    display: inline-block;
  }
  .headline .outline:hover {
    color: var(--red);
    animation: glitch 0.35s steps(2) infinite;
  }
  @keyframes glitch {
    0%   { transform: translate(0) skewX(0); }
    20%  { transform: translate(-3px, 1px) skewX(-3deg); }
    40%  { transform: translate(3px, -1px) skewX(3deg); }
    60%  { transform: translate(-2px, 2px) skewX(-2deg); }
    80%  { transform: translate(2px, -2px) skewX(2deg); }
    100% { transform: translate(0) skewX(0); }
  }

  /* Accent word with underline sweep */
  .headline .accent {
    color: var(--red);
    position: relative;
    display: inline-block;
  }
  .headline .accent::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.05em;
    height: 5px;
    background: var(--red);
    transform: scaleX(0); transform-origin: left;
    animation: underlineSweep 1s var(--expo) 1.9s forwards;
  }
  @keyframes underlineSweep {
    to { transform: scaleX(1); }
  }

  /* Decorative caret that types after the headline */
  .caret {
    display: inline-block;
    width: 0.08em; height: 0.9em;
    background: var(--red);
    margin-left: 0.08em;
    vertical-align: -0.06em;
    animation: caretBlink 1s steps(1) infinite;
    box-shadow: 0 0 14px var(--red-glow);
  }
  @keyframes caretBlink {
    50% { opacity: 0; }
  }

  /* Sub copy */
  .sub {
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.65;
    color: var(--grey);
    max-width: 520px;
    margin-bottom: 44px;
    opacity: 0;
    animation: fadeUp 0.9s var(--ease) 1.4s forwards;
  }
  .sub strong { color: var(--white); font-weight: 500; }

  /* ============ CTAs ============ */
  .ctas {
    display: flex; flex-wrap: wrap; gap: 20px; align-items: center;
    opacity: 0;
    animation: fadeUp 0.9s var(--ease) 1.6s forwards;
  }

  .btn {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 18px 34px;
    font-size: 0.76rem; font-weight: 700;
    letter-spacing: 0.24em; text-transform: uppercase;
    text-decoration: none;
    position: relative; overflow: hidden;
    transition: transform 0.4s var(--spring);
    will-change: transform;
    cursor: none;
  }

  .btn--primary {
    background: var(--red);
    color: var(--white);
    border: 2px solid var(--red);
    box-shadow: 0 0 0 0 var(--red-glow);
  }
  .btn--primary::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--black);
    transform: translateX(-101%);
    transition: transform 0.55s var(--ease);
    z-index: 0;
  }
  .btn--primary > * { position: relative; z-index: 1; }
  .btn--primary:hover::before { transform: translateX(0); }
  .btn--primary:hover {
    box-shadow: 0 0 32px 4px var(--red-glow);
  }

  .btn--ghost {
    background: transparent;
    color: var(--white);
    border: 2px solid rgba(255,255,255,0.2);
  }
  .btn--ghost::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--white);
    transform: translateY(101%);
    transition: transform 0.5s var(--ease);
    z-index: 0;
  }
  .btn--ghost > * {
    position: relative; z-index: 1;
    transition: color 0.4s var(--ease);
  }
  .btn--ghost:hover::before { transform: translateY(0); }
  .btn--ghost:hover > * { color: var(--black); }

  .btn .arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }
  .btn:hover .arrow { transform: translateX(6px); }

  /* ============ BOTTOM BAR ============ */
  .bottombar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--grey);
    opacity: 0;
    animation: fadeIn 1s var(--ease) 2s forwards;
    gap: 20px; flex-wrap: wrap;
  }
  .bottombar strong { color: var(--red); font-weight: 700; }

  .scroll-cue {
    display: inline-flex; align-items: center; gap: 10px;
    color: var(--grey); text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .scroll-cue:hover { color: var(--red); }
  .scroll-cue .chev {
    display: inline-block;
    animation: chevPulse 1.8s ease-in-out infinite;
  }
  @keyframes chevPulse {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50%      { transform: translateY(5px); opacity: 1; }
  }

  @keyframes fadeIn { to { opacity: 1; } }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ============ MARQUEE STRIP ============ */
  .marquee {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 44px;
    background: var(--red);
    color: var(--white);
    overflow: hidden;
    z-index: 15;
    display: flex;
    align-items: center;
    transform: translateY(100%);
    animation: marqueeIn 0.9s var(--ease) 2.3s forwards;
  }
  @keyframes marqueeIn {
    to { transform: translateY(0); }
  }
  .marquee-track {
    display: flex; gap: 40px;
    white-space: nowrap;
    animation: marquee 30s linear infinite;
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.35em; text-transform: uppercase;
    padding-left: 40px;
  }
  .marquee-track .sep { opacity: 0.45; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ============ MOBILE ============ */
  @media (max-width: 640px) {
    body { cursor: auto; }
    .cursor-dot, .cursor-ring { display: none; }
    .headline { font-size: clamp(2rem, 11vw, 3.4rem); }
    .marquee { height: 36px; }
    .marquee-track { font-size: 0.62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
</head>
<body>

<div class="cursor-ring" id="cursorRing"></div>
<div class="cursor-dot" id="cursorDot"></div>

<section class="hero">

  <div class="grid"></div>
  <div class="orbit-ring"></div>
  <div class="orbit-ring"></div>
  <div class="orbit-ring"></div>
  <canvas id="canvas"></canvas>

  <div class="content">

    <header class="topbar">
      <div class="brand">
        <span class="ted">TEDx</span><span class="vit">VIT</span>
